# ==============================================================================
# GhitaPowerPointConverter - Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System & Filesystem Junk
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# Windows reserved device names / accidental files
/nul

# ------------------------------------------------------------------------------
# 2. General / Temporary / Log Files
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej
*.dmp
*.swp
*.swo
*.class
*.pyc
*.pyo
.history/
.buildlog/
.atom/
.svn/
/tmp/

# SQLite & local databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal

# Secrets & Local Environment
.env
.env.*
!.env.example
*.pem
*.key

# Code-signing certificates (T45 ký installer).
# .pfx/.p12 CHỨA KHÓA RIÊNG — không bao giờ commit. Đặt ngoài repo hoặc ngoài máy.
*.pfx
*.p12
*.jks
*.keystore
# .cer chỉ chứa khóa công khai: an toàn để commit nếu cần.
/signing/
*.pubkey

# ------------------------------------------------------------------------------
# 3. IDEs & Editors
# ------------------------------------------------------------------------------
# JetBrains / Android Studio
.idea/
*.iml
*.ipr
*.iws
out/

# Visual Studio Code & Visual Studio
.vscode/
.vs/
*.suo
*.user
*.userosv
*.userosscache
*.sln.docstates
*.slncache

# Other Editors & Tools
.fleet/
.cursor/
.zed/

# ------------------------------------------------------------------------------
# 4. AI Agents & Local Session Tooling
# ------------------------------------------------------------------------------
.zcode/
.freebuff/
.fvm/
.gemini/
.agents/
.continue/
.aider*
*.local.md
scratch/

# ------------------------------------------------------------------------------
# 5. Flutter & Dart Build Artifacts
# ------------------------------------------------------------------------------
# Flutter build outputs
build/
**/build/
.dart_tool/
**/.dart_tool/

# Package dependencies & plugins
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# ------------------------------------------------------------------------------
# 6. Windows & C++ / CMake Build Artifacts
# ------------------------------------------------------------------------------
windows/flutter/ephemeral/
**/ephemeral/
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.pdb
*.idb
*.ilk
*.obj
*.res
*.tlog
*.exp
*.lib
*.dll
*.exe

# ------------------------------------------------------------------------------
# 7. Rust & Cargo (Ghita Native Core)
# ------------------------------------------------------------------------------
# Cargo build outputs (Cargo.lock và source được commit để build tái lập)
target/
**/target/
/rust/target/
**/*.rs.bk

# ------------------------------------------------------------------------------
# 8. Testing & Quality Assurance
# ------------------------------------------------------------------------------
coverage/
*.lcov
*.lcov.info

# ------------------------------------------------------------------------------
# 9. Installer & Packaging
# ------------------------------------------------------------------------------
/installer/output/
/installer/installer/
*.iss.bak

# ------------------------------------------------------------------------------
# 10. Tooling & Preview Caches
# ------------------------------------------------------------------------------
# Edge headless profiles & preview caches generated by tool scripts
/tool/template_previews/_edgeprofile*/

# ------------------------------------------------------------------------------
# 11. Tài liệu kế hoạch nội bộ & bằng chứng đo (quy tắc 3 trong AGENT.md)
# ------------------------------------------------------------------------------
# Không bao giờ được commit hay push. Nếu lỡ commit: xoá vĩnh viễn khỏi TOÀN BỘ
# lịch sử git (xem AGENT.md mục 3) rồi mới push.
/RELEASE_PLAN_*.md
/ROADMAP_*.md
/installer/demo_manual_checklist.md
/tool/benchmark_results_*.md
/tool/ram_results_*.md
/tool/template_mockups/*.md

# Kết quả đo hiện thời (sinh bởi harness, so với perf_baseline.json ở gate)
/tool/perf_current.json
